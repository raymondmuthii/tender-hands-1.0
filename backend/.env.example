# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-before-deploy

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (local dev): leave commented out – defaults to sqlite:///tender_hands_dev.db
# DATABASE_URL=sqlite:///tender_hands_dev.db

# PostgreSQL (production): Vercel / Railway / Neon etc.
# DATABASE_URL=postgresql://user:password@host:5432/tender_hands

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-jwt-secret-too

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── M-Pesa (Safaricom Daraja) ──────────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-lipa-na-mpesa-passkey
MPESA_CALLBACK_URL=https://your-backend-domain.com/api/mpesa/callback
